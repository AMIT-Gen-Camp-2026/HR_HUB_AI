# ============================================================
# Hugging Face — CV extraction (app/providers/hf_provider.py)
# ============================================================
HF_API_TOKEN=your_huggingface_token_here

# سلسلة الموديلات بالترتيب - لو الأول فشل (quota/rate-limit/JSON تالف)
# بنجرب اللي بعده. الأسماء لازم تتحقق من صفحة الموديل على huggingface.co
# (تبويب Inference Providers) قبل أي تعديل.
HF_MODEL_ID_1=Qwen/Qwen2.5-3B-Instruct
HF_PROVIDER_1=featherless-ai
HF_MODEL_ID_2=mistralai/Mistral-7B-Instruct-v0.2
HF_PROVIDER_2=featherless-ai

# ============================================================
# Embeddings — semantic_fit() في الـ ranking (app/providers/embeddings.py)
# ============================================================
# "local" = sentence-transformers على جهازك (لازم pip install -e ".[hf]")
# "api"   = أي مزود متوافق مع OpenAI embeddings API (افتراضيًا Gemini)
EMBEDDING_PROVIDER=api

# لو EMBEDDING_PROVIDER=api (الوضع الحالي - Gemini):
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_API_MODEL=gemini-embedding-001
EMBEDDING_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# لو EMBEDDING_PROVIDER=local:
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu


# ============================================================
# Service-to-service auth (app/security/auth.py)
# ============================================================
# مطلوب قبل أي deployment متاح لغير جهازك. لو فاضي، الـ endpoints بتفضل
# شغالة من غير حماية (fail-open، للتطوير المحلي بس).
# اعمل قيمة عشوائية قوية، مثلاً: python -c "import secrets; print(secrets.token_urlsafe(32))"
AI_SERVICE_API_KEY=



# ============================================================
# Flask
# ============================================================
FLASK_DEBUG=True
FLASK_PORT=5000

# ============================================================
# Feature flags
# ============================================================
RANKING_ENABLED=True