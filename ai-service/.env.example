# ============================================================
# LLM Providers (Extraction & Semantic Judge)
# ============================================================
# المزود الافتراضي للاستخراج: auto (يجرب المتاح بالترتيب: Gemini -> Groq -> OpenRouter -> Hugging Face)
# أو يمكنك تحديد مزود بعينه: gemini أو groq أو openrouter أو hf
EXTRACTION_PROVIDER=auto

# 1. Google Gemini (موصى به - سريع، سياق كبير، بدون انقطاع أو بتر JSON)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EXTRACTION_MODEL=gemini-3.6-flash
GEMINI_JUDGE_MODEL=gemini-3.6-flash

# 2. Groq (فائق السرعة مع دعم JSON mode)
GROQ_API_KEY=your_groq_api_key_here
GROQ_EXTRACTION_MODEL=openai/gpt-oss-120b
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 3. OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_EXTRACTION_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_JUDGE_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost

# 4. Hugging Face Inference Providers
HF_API_TOKEN=your_huggingface_token_here
HF_MODEL_ID_1=Qwen/Qwen2.5-3B-Instruct
HF_PROVIDER_1=featherless-ai
HF_MODEL_ID_2=mistralai/Mistral-7B-Instruct-v0.2
HF_PROVIDER_2=featherless-ai

# ============================================================
# Embeddings — semantic_fit() في الـ ranking (app/providers/embeddings.py)
# ============================================================
# "local" = sentence-transformers على جهازك (لازم pip install -e ".[hf]")
# "api"   = أي مزود متوافق مع OpenAI embeddings API (افتراضيًا Gemini)
EMBEDDING_PROVIDER=api

# لو EMBEDDING_PROVIDER=api (Gemini):
EMBEDDING_API_MODEL=gemini-embedding-001
EMBEDDING_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# لو EMBEDDING_PROVIDER=local:
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=cpu

# ============================================================
# Service-to-service auth (app/security/auth.py)
# ============================================================
AI_SERVICE_API_KEY=

# ============================================================
# Flask & App Settings
# ============================================================
FLASK_DEBUG=True
FLASK_PORT=5000
RANKING_ENABLED=True
MAX_NEW_TOKENS=4096
MODEL_TIMEOUT_SECONDS=60