# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Provider selection: api (Gemini) | hf | local | stub ---
PROVIDER=stub

# --- Gemini (scenario: api) ---
# Free tier key from https://aistudio.google.com — see docs/PROVIDERS.md for quota notes.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60

# --- Hugging Face embeddings (scenario: hf / used for evidence matching regardless of PROVIDER) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_DEVICE=cpu
# Only needed if HF_MODE=inference_api; leave empty to run the embedding model locally (recommended).
HF_TOKEN=
HF_MODE=local_transformers

# --- Local LLM (scenario: local, e.g. Ollama) ---
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL=qwen2.5:7b-instruct

# --- Feature flags ---
FEATURE_IMAGE_ANALYSIS=false
FEATURE_WEB_GROUNDING=true

# --- Free-tier usage guardrails ---
DAILY_REQUEST_CAP=1200
CLAIM_BATCH_SIZE=5

# --- Flask ---
FLASK_APP=app.main:create_app
FLASK_ENV=development
FLASK_DEBUG=1
API_PORT=8100
LOG_LEVEL=INFO
